# LLM API Keys
CLAUDE_API_KEY=your_claude_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key
GROK_API_KEY=your_grok_api_key
OPENAI_API_KEY=your_openai_api_key

# 默认模型
DEFAULT_MODEL=claude

# Notion
NOTION_TOKEN=your_notion_token

# Stock API
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# ==================== Notification Channels ====================

# Telegram (recommended - easiest to set up)
# 1. Create a bot via @BotFather on Telegram
# 2. Get your chat ID by sending /start to @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord (webhook mode - no bot needed)
# 1. Server Settings > Integrations > Webhooks > New Webhook
# 2. Copy the webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Discord (bot mode - more features)
# DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_CHANNEL_ID=your_channel_id

# Slack
# 1. Create an app at api.slack.com
# 2. Add Incoming Webhooks and create a webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# Generic Webhook (any HTTP endpoint)
# NOTIFICATION_WEBHOOK_URL=https://your-server.com/webhook

# ==================== App Config ====================
DEBUG=true
